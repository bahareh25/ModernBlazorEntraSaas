@inherits LayoutComponentBase
@using MudBlazor;
<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <!-- TOP BAR -->
    <MudAppBar Color="Color.Primary" Elevation="1">
        <MudText Typo="Typo.h6">URL Shortener</MudText>
    </MudAppBar>

    <!-- SIDEBAR -->
    <MudDrawer Open="true" Variant="DrawerVariant.Persistent">

        <MudNavMenu>

            <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>

            <MudNavLink Href="/short-link-list" Icon="@Icons.Material.Filled.Link">
                Links
            </MudNavLink>

        </MudNavMenu>

    </MudDrawer>

    <!-- MAIN CONTENT -->
    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>

</MudLayout>

